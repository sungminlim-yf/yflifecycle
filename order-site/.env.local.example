# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요 (.env.local은 git 무시됨)

# n8n 인스턴스
N8N_BASE_URL=https://youngfoods.app.n8n.cloud
# #1 주문 인입 webhook path
N8N_ORDER_INTAKE_PATH=yf-order-intake-v1

# #1 webhook의 header auth — n8n credential 'order-intake-token'(dY4EiGLUEsseUd4h)의
# 헤더 '이름'과 '값'을 그대로 입력. (n8n UI → Credentials → order-intake-token에서 확인)
N8N_ORDER_INTAKE_HEADER_NAME=Authorization
N8N_ORDER_INTAKE_HEADER_VALUE=__n8n_BLANK_VALUE_e5362baf-c777-4d57-a609-6eaf1f9e87f6
